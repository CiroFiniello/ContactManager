@{
    ViewData["Title"] = "Home";
}

<div class="py-4">

    <section class="bg-dark text-white rounded-3 p-4 p-md-5 shadow-sm mb-4">
        <span class="badge bg-primary mb-3">
            ContactManager
        </span>

        <h1 class="display-5 fw-bold mb-3">
            La tua rubrica, organizzata.
        </h1>

        <p class="lead text-white-50 mb-4">
            Gestisci contatti, aziende e informazioni
            in un unico posto.
        </p>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Contacts"
               asp-action="Index"
               class="btn btn-light btn-lg">
                Visualizza contatti
            </a>

            <a asp-controller="Contacts"
               asp-action="Create"
               class="btn btn-outline-light btn-lg">
                + Nuovo contatto
            </a>
        </div>
    </section>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-semibold">Ricerca</h5>
                    <p class="text-muted mb-0">
                        Trova i contatti per nome, email,
                        telefono o azienda.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-semibold">Gestione</h5>
                    <p class="text-muted mb-0">
                        Crea, modifica e consulta
                        le informazioni dei contatti.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="fw-semibold">Validazione</h5>
                    <p class="text-muted mb-0">
                        Controlla i dati inseriti ed evita
                        indirizzi email duplicati.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
