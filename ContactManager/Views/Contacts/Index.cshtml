@model IEnumerable<ContactManager.Models.Contact>

@{
    ViewData["Title"] = "Contatti";

    var currentFilter = ViewData["CurrentFilter"] as string;
    var hasFilter = !string.IsNullOrWhiteSpace(currentFilter);
    var hasContacts = Model.Any();
}

<div class="py-4">

    <!-- Intestazione -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h2 fw-bold mb-1">Contatti</h1>
            <p class="text-muted mb-0">
                Gestisci e organizza la tua rubrica.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Home
            </a>

            <a asp-action="Create"
               class="btn btn-primary">
                + Nuovo contatto
            </a>
        </div>
    </div>

    <!-- Ricerca -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get"
                  class="row g-2 align-items-end"
                  role="search">

                <div class="col-12 col-md-8">
                    <label for="searchTerm"
                           class="form-label fw-semibold">
                        Cerca contatti
                    </label>

                    <input type="search"
                           id="searchTerm"
                           name="searchTerm"
                           value="@currentFilter"
                           placeholder="Nome, email, azienda, telefono..."
                           class="form-control" />
                </div>

                <div class="col-6 col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Cerca
                    </button>
                </div>

                <div class="col-6 col-md-2">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        Reset
                    </a>
                </div>
            </form>

            @if (hasFilter)
            {
                <p class="text-muted small mt-3 mb-0">
                    Risultati della ricerca per:
                    <strong class="text-dark">@currentFilter</strong>
                </p>
            }

        </div>
    </div>

    <!-- Elenco contatti -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h5 fw-semibold mb-0">
                    Elenco contatti
                </h2>

                <span class="badge bg-secondary">
                    @Model.Count() risultati
                </span>
            </div>
        </div>

        @if (!hasContacts)
        {
            <div class="card-body text-center py-5">
                <h3 class="h5 fw-semibold">
                    Nessun contatto trovato
                </h3>

                <p class="text-muted mb-3">
                    @if (hasFilter)
                    {
                        <span>
                            Nessun contatto corrisponde alla tua ricerca.
                        </span>
                    }
                    else
                    {
                        <span>
                            La tua rubrica è ancora vuota.
                        </span>
                    }
                </p>

                @if (hasFilter)
                {
                    <a asp-action="Index"
                       class="btn btn-outline-primary">
                        Mostra tutti
                    </a>
                }
                else
                {
                    <a asp-action="Create"
                       class="btn btn-primary">
                        + Crea il primo contatto
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">
                                Nome
                            </th>
                            <th scope="col">Cognome</th>
                            <th scope="col">Email</th>
                            <th scope="col">Telefono</th>
                            <th scope="col">Azienda</th>
                            <th scope="col" class="text-end pe-4">
                                Azioni
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @item.Nome
                                </td>

                                <td>@item.Cognome</td>

                                <td>
                                    <a href="mailto:@item.Email"
                                       class="text-decoration-none">
                                        @item.Email
                                    </a>
                                </td>

                                <td>
                                    @(item.Telefono ?? "—")
                                </td>

                                <td>
                                    @(item.Azienda ?? "—")
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Dettagli
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Modifica
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Elimina
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
